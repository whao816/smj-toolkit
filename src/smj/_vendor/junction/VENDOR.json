  "local_patches": [
    {
      "id": "F2-te-present",
      "commit": "bc7febf",
      "files": [
        "criteria.py",
        "validate.py"
      ],
      "what": "无 TE.dat 时登记 te_present(engineering/error, missing=True)，physics_verdict([]) 返回 inconclusive 而非通过；validate_junction_run 接受 temperature 参数。",
      "why": "原实现里空 aitranss_te/ 目录会得到 passed=True / 支持 H0，缺证据被当成通过（P0 fail-open）。",
      "tests": [
        "tests/test_criteria_failopen.py"
      ]
    },
    {
      "id": "F1-mos-aims-head",
      "commit": "f7d3970",
      "files": [
        "artifacts.py"
      ],
      "what": "新增 AIMS_HEAD_STAGES=('aims_scf',)，只有 aims_scf 的 retrieval_plan 才带 mos.aims/omat.aims 的 head 条目。",
      "why": "原先所有阶段都收到 head 条目，gaussian_opt 等阶段凭空多出必然 missing 的项；真正消费 head 的下载逻辑在 smj/remote.py（非 vendored）。",
      "tests": [
        "tests/test_remote_mos_head.py"
      ]
    },
    {
      "id": "F4-pending-message",
      "commit": "fe48c29",
      "files": [
        "review.py"
      ],
      "what": "pending_message 不再提示主仓的 `agenticdft smj-review`，改为说明独立包的真实入口 `smj review --approve --who <名字>`。",
      "why": "该提示指向独立包里不存在的命令（且该检查点模块本身未接线）。",
      "tests": [
        "tests/test_connection_check_approve.py"
      ]
    },
    {
      "id": "F-LIB-library-electrode",
      "commit": "00294d9",
      "files": [
        "electrode.py",
        "inputs.py"
      ],
      "what": "新增 LibraryElectrode（直接吃 FHI-aims electrodes.library 的预定义团簇）、backplane_indices（按输运轴取背层整层）；append_au60 接受 cluster/provenance 并写 electrode_source / library_cluster / left|right_backplane_indices；新增 make_au_relax_input（背层整层 constrain_relaxation + bfgs）。",
      "why": "手册 §5.3.1 要求用 electrodes.library 的预定义团簇，并在贴装后固定两个背层做一次弛豫；原独立包只能自建三角岛、且没有弛豫阶段。",
      "tests": [
        "tests/test_library_au_relax.py"
      ]
    },
    {
      "id": "F-RELAX-au-relax-stage",
      "commit": "00294d9",
      "files": [
        "artifacts.py",
        "review.py"
      ],
      "what": "artifacts 登记 au_relax 的回取清单；review.find_build_dir 优先 run_dir/au_relax（连接核对（原 A2/表面核对）审计对象改为真正送 SCF 的弛豫后几何）。",
      "why": "0.1.2 新增 au_relax 阶段；不登记会被 download 视为 unknown，连接核对也会继续审计未弛豫的 au60_build 几何。",
      "tests": [
        "tests/test_library_au_relax.py",
        "tests/test_connection_check_approve.py"
      ]
    },
    {
      "id": "F-ELEC-element-lattice",
      "commit": "2026-11-15",
      "files": [
        "electrode.py",
        "geometry.py",
        "inputs.py",
        "self_energy.py",
        "validate.py",
        "a2_viz.py"
      ],
      "what": "电极金属可参数化：add_tip_au(element=…)、make_tip_relax_input(tip_element=…)、append_au60(element=, a_lattice=) 在非 Au 时写 electrode_element/electrode_a_lattice、make_self_energy(element=…)、validate/a2_viz 从 metadata 读电极元素。",
      "why": "阶段 4「构建电极」要求 source/library 与电极类型（Au/Ag/Cu/Ni/Pt/Pd/Al 或显式 a_lattice）都是参数；原实现只认 Au，tip/自能/校验全硬编码。",
      "tests": [
        "tests/test_electrode_metals.py",
        "tests/test_no_sulfur_anchor.py"
      ]
    },
    {
      "id": "F-CCHECK-rename",
      "commit": "2026-11-15",
      "files": [
        "validate.py",
        "a2_viz.py",
        "fingerprint.py",
        "criteria.py",
        "review.py"
      ],
      "what": "「A2 人工确认」→「表面核对」→「连接核对」更名：check 名 junction_connection_check；a2_viz 文案与默认文件名改 connection_check_*（保留数据键 area_A2）；fingerprint 写 connection_check.json、仍读旧 surface_check.json / a2_confirmation.json；criteria 登记判据族 BPY。",
      "why": "用户可理解的命名 + 默认自动登记（auto_connection_check）+ BPY 不再被 Au–BDT–Au 标定的判据带 fail-safe 误判。",
      "tests": [
        "tests/test_connection_check_approve.py",
        "tests/test_cli_connection_check.py",
        "tests/test_runner_connection_check.py",
        "tests/test_review_family_drift.py",
        "tests/test_family.py"
      ]
    },
    {
      "id": "F-FAMILY-sme",
      "commit": "2026-11-15",
      "files": [
        "criteria.py"
      ],
      "what": "SYSTEM_FAMILIES 登记判据族 SME（Au-(1,4-bis(methylthio)benzene)-Au），让 t_ef_magnitude / g_in_theory_band / seebeck_sign 记「不适用（仅记录）」而不是闸门。",
      "why": "这三条判据带都按 Au–BDT–Au 硫醇盐标定（0.03–0.40 G0、Seebeck 正号）；甲硫基（硫醚）是配位型接触，S 上无 H、不脱质子，带内数值对它没有参考意义，不登记族名会把一次物理上正常的算例判成「否证 H0」。",
      "tests": [
        "tests/test_family.py"
      ]
    }
  ],
  "note": "0.1.1 本地补丁的权威记录；回迁主仓后应删除对应条目并重新 sync。本文件由 scripts/gen_vendor_json.py 生成，勿手改。"
