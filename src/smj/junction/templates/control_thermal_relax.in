################################################################################
# FHI-aims geometry relaxation before the force-constant scan
################################################################################
  xc                 {xc}{vdw_line}
  spin               {spin}
  fixed_spin_moment  {fixed_spin_moment}
  relativistic       atomic_zora scalar
  charge             {charge}

  occupation_type    gaussian {occupation_width}
  mixer              pulay
  n_max_pulay        {n_max_pulay}
  charge_mix_param   {charge_mix_param}
  sc_accuracy_rho    1E-5
  sc_accuracy_eev    1E-3
  sc_accuracy_etot   1E-6
  sc_accuracy_forces {sc_accuracy_forces}
  sc_iter_limit      {sc_iter_limit}

  compute_forces .true.
  final_forces_cleaned .true.

  relax_geometry bfgs {force_threshold}
  aggregated_energy_tolerance 1.0e-1

  # 2D-periodic slab: in-plane sampling only (kz must stay 1 with ~20 Ang vacuum).
  k_grid {kx} {ky} {kz}

  # No output aitranss / output mulliken / 
estart aims.restart: this stage
  # only produces the relaxed geometry that the force-constant scan starts from.

################################################################################
# Species blocks appended below
################################################################################
{species_blocks}
